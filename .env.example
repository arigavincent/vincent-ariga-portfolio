# Copy to .env (gitignored) and fill in. Used by docker-compose.yml.
# Never commit the real .env.

# --- Database ---------------------------------------------------------------
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
# Required. Pick any strong local password.
POSTGRES_PASSWORD=

# Host ports (change if something else already uses them)
POSTGRES_PORT=5432
BACKEND_PORT=8080

# --- Security ---------------------------------------------------------------
# Required. Signs admin access tokens. At least 32 bytes: openssl rand -base64 48
APP_JWT_SECRET=

# First admin account, created on startup if it does not exist yet.
# The password must be at least 12 characters. An existing account is never changed.
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=

# Comma-separated origins allowed to call the API from a browser.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Refresh cookie. Use secure=true behind HTTPS (always in production).
# Use same-site=None only when the frontend and API are on different sites.
APP_REFRESH_COOKIE_SECURE=false
APP_REFRESH_COOKIE_SAME_SITE=Lax

# --- Content ----------------------------------------------------------------
# Fill empty content tables with starter content on startup (never overwrites existing rows)
APP_SEED_ENABLED=true

# --- Contact form email (optional) -------------------------------------------
# Leave MAIL_HOST or APP_CONTACT_NOTIFY_TO empty to keep messages in the admin inbox only.
APP_CONTACT_NOTIFY_TO=
APP_CONTACT_NOTIFY_FROM=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
