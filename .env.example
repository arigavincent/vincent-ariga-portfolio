# Copy to .env (gitignored) and fill in. Used by docker-compose.yml.

POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
# Required. Pick any strong local password.
POSTGRES_PASSWORD=

# Host ports (change if something else already uses them)
POSTGRES_PORT=5432
BACKEND_PORT=8080

# Fill empty content tables with starter content on startup (never overwrites existing rows)
APP_SEED_ENABLED=true
